# App
NODE_ENV=development
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/precursor

# GGG OAuth 2.1
GGG_CLIENT_ID=your_client_id
GGG_CLIENT_SECRET=your_client_secret
GGG_REDIRECT_URI=https://api.precursor.nexus/auth/callback
GGG_TOKEN_STORE=./ggg-token.json

# Cron
CRON_LADDER_SCHEDULE="0 0 * * *"
CRON_CLUSTERS_SCHEDULE="0 1 * * *"
CRON_ECONOMY_SCHEDULE="0 2 * * *"
CRON_MATCH_SCHEDULE="0 3 * * *"
LEAGUE_NAME=Dawn of the Hunt

# GGG API
GGG_API_BASE=https://www.pathofexile.com/api
GGG_LADDER_SAMPLE_SIZE=1000

# RePoE
REPOE_BASE_URL=https://repoe-fork.github.io
SKILLTREE_REPO=https://raw.githubusercontent.com/grindinggear/skilltree-export/master

# Monitoring
SENTRY_DSN=https://xxxx@sentry.io/xxxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# Cache
CACHE_TTL_SECONDS=300

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
